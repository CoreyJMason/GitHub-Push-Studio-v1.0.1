{
  "name": "github-push-studio",
  "version": "1.0.1",
  "private": true,
  "description": "A safe, simple desktop GitHub publishing studio",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "desktop": "electron .",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "doctor": "python scripts/doctor.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
